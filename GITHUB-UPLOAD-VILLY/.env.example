# ─── Required ────────────────────────────────────────────────────────────────

# Public site URL (canonicals, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://thassosboats.gr

# Admin login password (min. 24 random characters)
ADMIN_SECRET=generate-a-strong-random-password-here

# Separate key for signing admin session cookies (must differ from ADMIN_SECRET)
SESSION_SIGNING_KEY=generate-another-long-random-string-here

# Random salt for hashing IP addresses in consent logs
GDPR_SALT=generate-a-random-salt-here

# Marina timezone for booking date validation (e.g. Europe/Athens)
SITE_TIMEZONE=your-timezone-here

# Set true when deployed behind a reverse proxy (Netlify, nginx, etc.)
TRUST_PROXY=your-true-or-false

# ─── Booking email (Resend) ──────────────────────────────────────────────────
# Without RESEND_API_KEY, bookings are saved to SQLite only (no email sent).
# Get a key at https://resend.com
# RESEND_API_KEY=re_xxxxxxxx

# Server-only recipient for booking notifications (required to send email)
# BOOKING_NOTIFICATION_EMAIL=your-inbox@example.com

# Verified sender domain in Resend (use onboarding@resend.dev for sandbox)
# RESEND_FROM_EMAIL=Rent A Boat Villy <bookings@thassosboats.gr>

# Dev only: override recipient locally (ignored in production)
# BOOKING_TEST_EMAIL=dev-inbox@example.com

# ─── Optional ────────────────────────────────────────────────────────────────

# Google Search Console site verification
GOOGLE_SITE_VERIFICATION=

# Google Maps — only if you add an embedded Maps component (not used by default)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ─── AI chat assistant (optional, Groq) ──────────────────────────────────────
# Get a key from https://console.groq.com/keys and add it in Vercel env vars.
# Without GROQ_API_KEY, the chatbot falls back to the built-in safe local replies.
# GROQ_API_KEY=gsk_xxxxxxxx
# GROQ_CHAT_MODEL=llama-3.1-8b-instant

# ─── Auto-translation (optional) ─────────────────────────────────────────────
# Without keys, MyMemory free tier is used; set TRANSLATION_DISABLE=true to skip APIs.
# TRANSLATION_PROVIDER=google | libretranslate | mymemory
# TRANSLATION_API_KEY=
# TRANSLATION_API_URL=
# TRANSLATION_DISABLE=true

# ─── Setup ───────────────────────────────────────────────────────────────────
# Copy to .env.local (dev) or set in your hosting dashboard (production).
# Never commit real secrets or private notification addresses.
